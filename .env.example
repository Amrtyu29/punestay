# Copy this file to .env and adjust if needed.
POSTGRES_USER=punestay
POSTGRES_PASSWORD=punestay
POSTGRES_DB=punestay
# 5433, not 5432: this machine already runs a local PostgreSQL 16 on 5432.
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

OSRM_PORT=5000
OSRM_URL=http://localhost:5000
# Used when the local OSRM is not running. Public demo server, for demos and testing only.
OSRM_FALLBACK_URL=https://router.project-osrm.org

# Auth and uploads (Week 5). Registering with ADMIN_EMAIL gives that account the admin role.
# ADMIN_EMAIL=you@yourdomain.in
# ADMIN_SETUP_TOKEN=long-random-string-required-to-register-the-admin
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=72
UPLOAD_DIR=uploads
MAX_PHOTO_MB=8

# Nominatim requires a real contact in the User-Agent. Put your email here.
# Optional contact for the Nominatim User-Agent; leave empty or use a real address (a placeholder gets 403).
NOMINATIM_EMAIL=

# Pune bounding box: south,west,north,east
PUNE_BBOX=18.40,73.62,18.75,74.05

# GeoServer (Week 9, Nearby Services). Default admin login of a fresh install.
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver
